# AWS Credentials
# Configure estas variáveis de ambiente para autenticação AWS

# Credenciais de acesso (obrigatórias)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Região AWS (pode ser configurada também via appsettings.json)
AWS_DEFAULT_REGION=us-east-1

# Como obter as credenciais:
# 1. AWS Console → IAM → Users → Security credentials → Create access key
# 2. AWS CLI: aws configure (armazena em ~/.aws/credentials)
# 3. Para credenciais temporárias: aws sts assume-role

# IMPORTANTE: 
# - Nunca commite este arquivo com credenciais reais
# - Use .env para local, arquivos secrets para CI/CD
# - Em produção (EC2/ECS/Lambda), use IAM Roles ao invés de access keys
